# Base URL of the folder that holds model.onnx, tokenizer.json and
# tokenizer_config.json. Must end with "/". Leave unset to use the
# Hugging Face repository SCAI-NGO/nemotron-3-embed-1b-onnx-web.
# For development with a local export, run `pnpm serve-model` and use:
VITE_MODEL_BASE_URL=http://localhost:8765/
