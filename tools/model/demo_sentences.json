[
  {
    "sourceId": 121990,
    "lang": "jpn",
    "text": "猫が日なたで寝ている。",
    "owner": "tommy__san",
    "translationOf": null
  },
  {
    "sourceId": 196697,
    "lang": "jpn",
    "text": "ペルシャ猫がテーブルの下で眠っていた。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 207307,
    "lang": "jpn",
    "text": "その猫は私のそばで寝るのが好きだ。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 9011614,
    "lang": "jpn",
    "text": "毎朝、公園で犬を散歩させてるんだよ。",
    "owner": "bunbuku",
    "translationOf": null
  },
  {
    "sourceId": 193759,
    "lang": "jpn",
    "text": "もし雨なら遠足は中止です。",
    "owner": "small_snow",
    "translationOf": null
  },
  {
    "sourceId": 203520,
    "lang": "jpn",
    "text": "たとえ雨が降ろうとサイクリングにいくぞ。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 185136,
    "lang": "jpn",
    "text": "海からの風は湿っている。",
    "owner": "bunbuku",
    "translationOf": null
  },
  {
    "sourceId": 1256520,
    "lang": "jpn",
    "text": "今週は最悪だったよ。電車が二日連続で遅れてきたんだ。",
    "owner": "bunbuku",
    "translationOf": null
  },
  {
    "sourceId": 155763,
    "lang": "jpn",
    "text": "私は寝坊して始発電車に乗り遅れた。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 197008,
    "lang": "jpn",
    "text": "フランスではこの魚をどう料理しますか。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 8754830,
    "lang": "jpn",
    "text": "この近くに中華料理のお店はありますか？",
    "owner": "bunbuku",
    "translationOf": null
  },
  {
    "sourceId": 161223,
    "lang": "jpn",
    "text": "お茶よりもコーヒーの方が好きなんだ。",
    "owner": "small_snow",
    "translationOf": null
  },
  {
    "sourceId": 224908,
    "lang": "jpn",
    "text": "コーヒーはブラジルの主要産物の一つである。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 159861,
    "lang": "jpn",
    "text": "私はその本を初めから終わりまで読んだ。",
    "owner": "mookeee",
    "translationOf": null
  },
  {
    "sourceId": 110403,
    "lang": "jpn",
    "text": "彼はよく私のそばに座り音楽を聞きます。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 212346,
    "lang": "jpn",
    "text": "その医者は私の命の恩人だ。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 118131,
    "lang": "jpn",
    "text": "彼の医者は彼にアルコール類は飲むなと命じた。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 160660,
    "lang": "jpn",
    "text": "私はサッカーをするのが好きだ。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 185110,
    "lang": "jpn",
    "text": "海の近くに住んでいるのに、彼女は泳げない。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 194543,
    "lang": "jpn",
    "text": "もう一度富士山に登りたいな。",
    "owner": "small_snow",
    "translationOf": null
  },
  {
    "sourceId": 920490,
    "lang": "jpn",
    "text": "税金を払うようになって、初めて人生が始まる。",
    "owner": "hambird",
    "translationOf": null
  },
  {
    "sourceId": 155533,
    "lang": "jpn",
    "text": "私は税金に二百ドル払った。",
    "owner": "bunbuku",
    "translationOf": null
  },
  {
    "sourceId": 185391,
    "lang": "jpn",
    "text": "会議に遅れてすみません。",
    "owner": "small_snow",
    "translationOf": null
  },
  {
    "sourceId": 127344,
    "lang": "jpn",
    "text": "誕生日には新しい自転車をあげよう。",
    "owner": "small_snow",
    "translationOf": null
  },
  {
    "sourceId": 223728,
    "lang": "jpn",
    "text": "このコンピューターは強力で効率がよく使いやすい。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 166847,
    "lang": "jpn",
    "text": "私たちの庭には２本の桜の木があります。",
    "owner": null,
    "translationOf": null
  },
  {
    "sourceId": 9415241,
    "lang": "jpn",
    "text": "桜が咲いてるよ。",
    "owner": "small_snow",
    "translationOf": null
  },
  {
    "sourceId": 12531,
    "lang": "fra",
    "text": "Je ferai du vélo même s'il pleut.",
    "owner": "sacredceltic",
    "translationOf": 203520
  },
  {
    "sourceId": 6551,
    "lang": "fra",
    "text": "Je préfère le café au thé.",
    "owner": "Cocorico",
    "translationOf": 161223
  },
  {
    "sourceId": 683268,
    "lang": "fra",
    "text": "J'aime bien jouer au football.",
    "owner": "Paiooooo",
    "translationOf": 160660
  },
  {
    "sourceId": 3864,
    "lang": "fra",
    "text": "La vie commence quand on paie des impôts.",
    "owner": "zmoo",
    "translationOf": 920490
  },
  {
    "sourceId": 438435,
    "lang": "deu",
    "text": "Ich habe verschlafen und den ersten Zug verpasst.",
    "owner": "xtofu80",
    "translationOf": 155763
  },
  {
    "sourceId": 362256,
    "lang": "deu",
    "text": "Der Arzt hat mein Leben gerettet.",
    "owner": "Wolf",
    "translationOf": 212346
  },
  {
    "sourceId": 344423,
    "lang": "deu",
    "text": "Wir haben zwei Kirschbäume in unserem Garten.",
    "owner": "MUIRIEL",
    "translationOf": 166847
  },
  {
    "sourceId": 22241,
    "lang": "eng",
    "text": "Despite having lived near the sea, she still cannot swim.",
    "owner": "Objectivesea",
    "translationOf": 185110
  },
  {
    "sourceId": 31715,
    "lang": "eng",
    "text": "I wish to climb Mt. Fuji again.",
    "owner": "CK",
    "translationOf": 194543
  },
  {
    "sourceId": 61064,
    "lang": "eng",
    "text": "This computer is powerful, efficient, and easy to use.",
    "owner": "CN",
    "translationOf": 223728
  },
  {
    "sourceId": 22523,
    "lang": "eng",
    "text": "Sorry I'm late for the meeting.",
    "owner": "CK",
    "translationOf": 185391
  },
  {
    "sourceId": 1210410,
    "lang": "fra",
    "text": "Il écoutait de la musique.",
    "owner": "etoile",
    "translationOf": null
  }
]
